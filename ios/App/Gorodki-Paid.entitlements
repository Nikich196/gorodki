<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Возможности сборки Paid. Push (aps-environment), вход через Apple и чтение NFC
     добавим по чек-листу «Включение платного аккаунта» (PLAN.md, §9), когда аккаунт будет. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>$(APP_GROUP_ID)</string>
  </array>
</dict>
</plist>
