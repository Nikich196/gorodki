<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Возможности сборки Free. У бесплатного Apple ID доступны только App Groups,
     фоновые режимы, общий Keychain и ещё несколько (таблица Apple «Supported capabilities»). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>$(APP_GROUP_ID)</string>
  </array>
</dict>
</plist>
